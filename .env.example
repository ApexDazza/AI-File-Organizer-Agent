# AI File Organizer Agent Configuration
# Get your Gemini API key from: https://aistudio.google.com/app/apikey

GOOGLE_API_KEY=your_gemini_pro_api_key_here

# Default directory to organize (optional - will prompt if not set)
DEFAULT_TARGET_DIR=

# Safety boundary - highest level directory the agent can access
TOP_LEVEL_ALLOWED_PATH=~

# Debug mode for detailed output
DEBUG=False

# Enhanced Configuration for Ultimate File Organizer
ENABLE_CLOUD_SYNC=True
ENABLE_CONTENT_ANALYSIS=True
ENABLE_SMART_TAGGING=True
ORGANIZATION_STYLE=professional  # Options: professional, personal, creative, minimal
AUTO_BACKUP_BEFORE_ORGANIZE=True
MAX_FILES_PER_BATCH=100
